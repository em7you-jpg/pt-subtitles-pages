{"title": "Between Blankets and Tomorrow", "lines": [{"start": 11.08, "end": 12.16, "ja": "静かな部屋でパジャマのまま時計の針を指でなぞる夜", "ko_pron": "", "ko": "", "tag": "Verse 1"}, {"start": 12.28, "end": 12.34, "ja": "", "ko_pron": "", "ko": "", "tag": "Intro - instrumental"}, {"start": 26.0, "end": 33.0, "ja": "明日のことまだ考えてしまうから心が小さく跳ねている", "ko_pron": "", "ko": "", "tag": "Pre-Chorus"}, {"start": 46.88, "end": 53.88, "ja": "丸めたブランケット越しに願うのは今日より優しい夢の端", "ko_pron": "", "ko": "", "tag": "Chorus"}, {"start": 73.7, "end": 80.7, "ja": "ベッドサイドで淡く光る写真立てに少し手を伸ばしてみる", "ko_pron": "", "ko": "", "tag": "Verse 2"}, {"start": 85.32, "end": 92.32, "ja": "明日のことまだ考えてしまうから心が小さく跳ねている", "ko_pron": "", "ko": "", "tag": "Pre-Chorus"}, {"start": 102.46, "end": 109.46, "ja": "丸めたブランケット越しに願うのは今日より優しい夢の端", "ko_pron": "", "ko": "", "tag": "Chorus"}, {"start": 152.16, "end": 159.16, "ja": "深い呼吸で胸の奥に残るささやかな不安を沈めていく", "ko_pron": "", "ko": "", "tag": "Bridge"}, {"start": 168.8, "end": 175.8, "ja": "丸めたブランケット越しに願うのは明日も自分を信じられること", "ko_pron": "", "ko": "", "tag": "Final Chorus"}, {"start": 193.0, "end": 200.0, "ja": "小さな寝息が静かに溶けて新しい朝をそっと迎えにいく", "ko_pron": "", "ko": "", "tag": "Outro"}], "meta": {"timing_clamped": true, "max_line_dur_sec": 7.0, "gap_sec": 0.12, "min_dur_sec": 0.06, "changed_items": 17, "clipped_by_next": 8, "clipped_by_maxdur": 8}}