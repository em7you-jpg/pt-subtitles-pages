{"title": "hold and release", "lines": [{"start": 0.0, "end": 7.0, "ja": "ずっと握りしめていた小さなためらいが 指の隙間から静かにこぼれ落ちていく", "ko_pron": "", "ko": "", "tag": "Verse 1"}, {"start": 16.62, "end": 23.62, "ja": "まだ慣れない午後の空気 胸の奥がざわつくけど 新しい一歩にそっと期待してみる", "ko_pron": "", "ko": "", "tag": "Line 2"}, {"start": 28.98, "end": 35.98, "ja": "ためらいの影を抜けて 笑顔のままで進むよ 揺れる気持ちも全部連れて 今日は手を離そう", "ko_pron": "", "ko": "", "tag": "Chorus"}, {"start": 42.38, "end": 49.38, "ja": "ほどけていく心の結び目 もう少しだけ自分を信じて 風が背中を押した", "ko_pron": "", "ko": "", "tag": "Post-Chorus"}, {"start": 51.98, "end": 58.98, "ja": "迷いが消えるわけじゃないけど ふいに踏み出す足音が軽くなった気がした", "ko_pron": "", "ko": "", "tag": "Verse 2"}, {"start": 65.36, "end": 72.36, "ja": "遠ざかる過去のノイズ 目の前のドアが開いた瞬間に そっと深呼吸をした", "ko_pron": "", "ko": "", "tag": "Line 6"}, {"start": 78.36, "end": 85.36, "ja": "ためらいの影を抜けて 笑顔のままで進むよ 揺れる気持ちも全部連れて 今日は手を離そう", "ko_pron": "", "ko": "", "tag": "Chorus"}, {"start": 92.74, "end": 99.74, "ja": "ほどけていく心の結び目 もう少しだけ自分を信じて 風が背中を押した", "ko_pron": "", "ko": "", "tag": "Post-Chorus"}, {"start": 103.52, "end": 110.52, "ja": "いくつもの選択肢が並ぶ午後 迷いながらも歩き出していた昨日の自分にさよなら", "ko_pron": "", "ko": "", "tag": "Bridge"}, {"start": 128.54, "end": 135.54, "ja": "ためらいの影を抜けて 新しい光の中へ 揺れる気持ちも全部連れて 今日は手を離そう", "ko_pron": "", "ko": "", "tag": "Final Chorus"}, {"start": 145.34, "end": 152.34, "ja": "ほどけていく心の結び目 もう少しだけ自分を信じて", "ko_pron": "", "ko": "", "tag": "Post-Chorus Reprise"}], "meta": {"timing_clamped": true, "max_line_dur_sec": 7.0, "gap_sec": 0.12, "min_dur_sec": 0.06, "changed_items": 21, "clipped_by_next": 10, "clipped_by_maxdur": 11}}