{"title": "Softly Now, Someday", "lines": [{"start": 2.8, "end": 3.88, "ja": "かすかな光が差し込む廊下でそっと息をひそめて", "ko_pron": "", "ko": "", "tag": "Verse 1"}, {"start": 4.0, "end": 4.06, "ja": "", "ko_pron": "", "ko": "", "tag": "Intro - instrumental"}, {"start": 16.54, "end": 23.54, "ja": "知らないふりして胸の奥で時計が回る", "ko_pron": "", "ko": "", "tag": "Pre-Chorus"}, {"start": 25.12, "end": 32.12, "ja": "目を閉じて願いを数えている静かな時間が流れる", "ko_pron": "", "ko": "", "tag": "Line 4"}, {"start": 34.36, "end": 39.84, "ja": "まだ言えない言葉はポケットの奥で眠ってる", "ko_pron": "", "ko": "", "tag": "Chorus"}, {"start": 39.96, "end": 46.96, "ja": "きっとこの瞬間を待っている私だけのルール", "ko_pron": "", "ko": "", "tag": "Line 6"}, {"start": 55.88, "end": 60.88, "ja": "教室の隅で消しゴムを転がしながら考えてた", "ko_pron": "", "ko": "", "tag": "Verse 2"}, {"start": 61.0, "end": 67.32, "ja": "みんなの声が遠く聞こえる午後の静けさに溶けて", "ko_pron": "", "ko": "", "tag": "Line 8"}, {"start": 67.44, "end": 74.34, "ja": "知らないふりして胸の奥で時計が回る", "ko_pron": "", "ko": "", "tag": "Pre-Chorus"}, {"start": 74.46, "end": 79.62, "ja": "目を閉じて願いを数えている静かな時間が流れる", "ko_pron": "", "ko": "", "tag": "Line 10"}, {"start": 79.74, "end": 85.68, "ja": "まだ言えない言葉はポケットの奥で眠ってる", "ko_pron": "", "ko": "", "tag": "Chorus"}, {"start": 85.8, "end": 91.58, "ja": "きっとこの瞬間を待っている私だけのルール", "ko_pron": "", "ko": "", "tag": "Line 12"}, {"start": 91.7, "end": 98.7, "ja": "踏み出す勇気は靴箱の影に置いてきたまま", "ko_pron": "", "ko": "", "tag": "Bridge"}, {"start": 107.26, "end": 112.3, "ja": "それでも一歩だけ進めたら景色は変わるのかな", "ko_pron": "", "ko": "", "tag": "Line 14"}, {"start": 112.42, "end": 119.42, "ja": "まだ言えない言葉はポケットの奥で眠ってる", "ko_pron": "", "ko": "", "tag": "Final Chorus"}, {"start": 120.12, "end": 126.36, "ja": "きっとこの瞬間を待っている私だけのルール", "ko_pron": "", "ko": "", "tag": "Line 16"}, {"start": 126.48, "end": 132.04, "ja": "夢に描いた未来を静かに手の中で温めて", "ko_pron": "", "ko": "", "tag": "Line 17"}, {"start": 132.16, "end": 139.16, "ja": "いつかそっと声にできる日を信じている", "ko_pron": "", "ko": "", "tag": "Line 18"}, {"start": 141.18, "end": 148.18, "ja": "廊下に響く足音が背中を押してくれるようで", "ko_pron"