{"title": "Steady Like Candy", "lines": [{"start": 0.0, "end": 0.94, "ja": "毎日同じようで少し違うリズム弾む足取りで進んでゆくよ", "ko_pron": "", "ko": "", "tag": "Verse 1"}, {"start": 1.06, "end": 1.12, "ja": "", "ko_pron": "", "ko": "", "tag": "Intro - instrumental"}, {"start": 11.5, "end": 18.5, "ja": "ささやかな願いを胸に隠して微笑みが今日もひとつ増えていく", "ko_pron": "", "ko": "", "tag": "Pre-Chorus"}, {"start": 30.86, "end": 37.86, "ja": "変わらない景色じゃなくて手すりの冷たさ指でたしかめて", "ko_pron": "", "ko": "", "tag": "Chorus"}, {"start": 44.16, "end": 51.16, "ja": "教室の隅っこで笑い合う声が昨日より近く感じるんだ", "ko_pron": "", "ko": "", "tag": "Verse 2"}, {"start": 64.24, "end": 71.24, "ja": "ささやかな願いを胸に隠して微笑みが今日もひとつ増えていく", "ko_pron": "", "ko": "", "tag": "Pre-Chorus"}, {"start": 81.92, "end": 88.92, "ja": "変わらない景色じゃなくて手すりの冷たさ指でたしかめて", "ko_pron": "", "ko": "", "tag": "Chorus"}, {"start": 97.24, "end": 104.24, "ja": "失くした消しゴムも新しいページも全部積み重ねてきた日々の証", "ko_pron": "", "ko": "", "tag": "Bridge"}, {"start": 120.8, "end": 127.8, "ja": "変わらない景色じゃなくて手すりの冷たさ指でたしかめて いつか思い出すために今を大切に笑っていたいんだ", "ko_pron": "", "ko": "", "tag": "Final Chorus"}, {"start": 136.8, "end": 143.8, "ja": "夕焼け色のノートがカバンから覗く帰り道にも心は軽くなる", "ko_pron": "", "ko": "", "tag": "Outro"}], "meta": {"timing_clamped": true, "max_line_dur_sec": 7.0, "gap_sec": 0.12, "min_dur_sec": 0.06, "changed_items": 17, "clipped_by_next": 8, "clipped_by_maxdur": 8}}