{"title": "クリアな理由だけ持って", "lines": [{"start": 0.0, "end": 0.64, "ja": "目の前に広がる床の染みもぼんやりしてる朝に", "ko_pron": "", "ko": "", "tag": "Verse 1"}, {"start": 0.76, "end": 0.82, "ja": "", "ko_pron": "", "ko": "", "tag": "Intro - instrumental"}, {"start": 7.96, "end": 14.96, "ja": "まだ眠たいまま鞄を椅子に投げて息を整える", "ko_pron": "", "ko": "", "tag": "Line 3"}, {"start": 15.64, "end": 22.64, "ja": "忘れ物一つだけ机に残したままの昨日", "ko_pron": "", "ko": "", "tag": "Line 4"}, {"start": 25.08, "end": 31.0, "ja": "ため息混じりの音でカップが小さく響いた", "ko_pron": "", "ko": "", "tag": "Line 5"}, {"start": 31.12, "end": 36.48, "ja": "ここから始まる今日を自分の手で選び取る", "ko_pron": "", "ko": "", "tag": "Pre-Chorus"}, {"start": 36.6, "end": 42.54, "ja": "もう迷わないと小さく呟いた誰もいない部屋で", "ko_pron": "", "ko": "", "tag": "Line 7"}, {"start": 43.06, "end": 49.92, "ja": "振り返るたびに色が薄れていくノートの端", "ko_pron": "", "ko": "", "tag": "Chorus"}, {"start": 50.04, "end": 54.66, "ja": "この瞬間だけは嘘をつかずに進もうと決めた", "ko_pron": "", "ko": "", "tag": "Line 9"}, {"start": 54.78, "end": 60.02, "ja": "余計な言葉より静かな決意だけポケットに入れて", "ko_pron": "", "ko": "", "tag": "Line 10"}, {"start": 60.14, "end": 67.14, "ja": "立ち止まるより先へ歩く理由を一つだけ大事に", "ko_pron": "", "ko": "", "tag": "Line 11"}, {"start": 76.32, "end": 81.94, "ja": "電車の音が窓越しに遠くなって響いてくる", "ko_pron": "", "ko": "", "tag": "Verse 2"}, {"start": 82.06, "end": 88.28, "ja": "靴下のほつれすら今日は気にならない午前", "ko_pron": "", "ko": "", "tag": "Line 13"}, {"start": 88.4, "end": 92.18, "ja": "机の上で丸めた紙ごみをゴミ箱に投げたら", "ko_pron": "", "ko": "", "tag": "Line 14"}, {"start": 92.3, "end": 97.92, "ja": "もう戻れないと知ってる午後の光が差し込む", "ko_pron": "", "ko": "", "tag": "Line 15"}, {"start": 98.04, "end": 103.74, "ja": "ここから始まる今日を自分の手で選び取る", "ko_pron": "", "ko": "", "tag": "Pre-Chorus"}, {"start": 103.86, "end": 109.22, "ja": "もう迷わないと小さく呟いた誰もいない部屋で", "ko_pron": "", "ko": "", "tag": "Line 17"}, {"start": 109.34, "end": 115.34, "ja": "振り返るたびに色が薄れていくノートの端", "ko_pron": "", "ko": "", "tag": "Chorus"}, {"start": 115.46, "end": 120.44, "ja": "この瞬間だけは嘘をつかずに進もうと決めた", "ko_pron": "", "ko": "", "tag": "Line 19"}, {"start": 120.56, "end": 125.44, "ja": "余計な言葉より静かな決意だけポケットに入れて", "ko_pron": "", "ko": "", "tag": "Line 20"}, {"start": 125.56, "end": 131.4, "ja": "立ち止まるより先へ歩く理由を一つだけ大事に", "ko_pron": "", "ko": "", "tag": "Line 21"}, {"start": 131.52, "end": 136.46, "ja": "ビニール袋の隅に残った昨日のパンくずを捨てて", "ko_pron": "", "ko": "", "tag": "Bridge"}, {"start": 136.58, "end": 143.5, "ja": "静かな午後に響くテレビの音を消したら始まる", "ko_pron": "", "ko": "", "tag": "Line 23"}, {"start": 143.62, "end": 150.34, "ja": "振り返るたびに色が薄れていくノートの端", "ko_pron": "", "ko": "", "tag": "Final Chorus"}, {"start": 150.46, "end": 155.52, "ja": "この瞬間だけは嘘をつかずに進もうと決めた", "ko_pron": "", "ko": "", "tag": "Line 25"}, {"start": 155.64, "end": 160.68, "ja": "余計な言葉より静かな決意だけポケットに入れて", "ko_pron": "", "ko": "", "tag": "Line 26"}, {"start": 160.8, "end": 164.5, "ja": "立ち止まるより先へ歩く理由を一つだけ大事に", "ko_pron": "", "ko": "", "tag": "Line 27"}, {"start": 164.62, "end": 171.62, "ja": "もう戻らない部屋のドアを閉めて新しい音を探す", "ko_pron": "", "ko": "", "tag": "Line 28"}, {"start": 176.68, "end": 183.68, "ja": "電球の明かりが少しだけ揺れて消えるその瞬間まで", "ko_pron": "", "ko": "", "tag": "Outro"}], "meta": {"timing_clamped": true, "max_line_dur_sec": 7.0, "gap_sec": 0.12, "min_dur_sec": 0.06, "changed_items": 32, "clipped_by_next": 26, "clipped_by_maxdur": 5}}