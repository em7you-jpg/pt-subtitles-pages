{
  "title": "Quiet Steps, Tiny Triumphs",
  "lines": [
    {
      "start": 0.0,
      "end": 8.06,
      "ja": "小さなカップを棚に戻して今日の始まり合図にする",
      "ko": "",
      "ko_pron": "",
      "tag": "Verse 1"
    },
    {
      "start": 9.0,
      "end": 16.76,
      "ja": "揺れる薄いカーテン越しの光が手の甲に広がって",
      "ko": "",
      "ko_pron": "",
      "tag": "Pre-Chorus"
    },
    {
      "start": 17.54,
      "end": 26.74,
      "ja": "取り戻したい静かな勇気が胸奥でそっと息をする",
      "ko": "",
      "ko_pron": "",
      "tag": "Pre-Chorus"
    },
    {
      "start": 29.06,
      "end": 31.8,
      "ja": "洗面台の水音に合わせて深呼吸をひとつ繰り返す",
      "ko": "",
      "ko_pron": "",
      "tag": "Chorus"
    },
    {
      "start": 40.8,
      "end": 47.08,
      "ja": "何気ない朝の選択が少しずつ自分を変えていく",
      "ko": "",
      "ko_pron": "",
      "tag": "Chorus"
    },
    {
      "start": 55.86,
      "end": 63.24,
      "ja": "玄関マットに足を揃えて靴下の色を決めてみる",
      "ko": "",
      "ko_pron": "",
      "tag": "Verse 2"
    },
    {
      "start": 63.14,
      "end": 72.72,
