{
  "title": "Quiet Steps, Tiny Triumphs",
  "lines": [
    {
      "start": 9.227,
      "end": 18.553,
      "ja": "小さなカップを棚に戻して今日の始まり合図にする",
      "ko": "",
      "ko_pron": "",
      "tag": "Verse 1"
    },
    {
      "start": 18.453,
      "end": 27.78,
      "ja": "揺れる薄いカーテン越しの光が手の甲に広がって",
      "ko": "",
      "ko_pron": "",
      "tag": "Pre-Chorus"
    },
    {
      "start": 27.68,
      "end": 37.007,
      "ja": "取り戻したい静かな勇気が胸奥でそっと息をする",
      "ko": "",
      "ko_pron": "",
      "tag": "Pre-Chorus"
    },
    {
      "start": 36.907,
      "end": 46.233,
      "ja": "洗面台の水音に合わせて深呼吸をひとつ繰り返す",
      "ko": "",
      "ko_pron": "",
      "tag": "Chorus"
    },
    {
      "start": 46.133,
      "end": 55.46,
      "ja": "何気ない朝の選択が少しずつ自分を変えていく",
      "ko": "",
      "ko_pron": "",
      "tag": "Chorus"
    },
    {
      "start": 55.36,
      "end": 64.687,
      "ja": "玄関マットに足を揃えて靴下の色を決めてみる",
      "ko": "",
      "ko_pron": "",
      "tag": "Verse 2"
    },
    {
      "start": 64.587,
      "end": 73.913,
      "ja": "小さなルール守るたびに昨日よりも心が軽い",
      "ko": "",
