{
  "title": "Stay on This Rail",
  "lines": [
    {
      "start": 0.0,
      "end": 5.56,
      "ja": "いつも通りの坂道を手を離さずに歩いていく",
      "ko_pron": "",
      "ko": "",
      "tag": "Verse 1"
    },
    {
      "start": 5.56,
      "end": 13.64,
      "ja": "ふと振り返ると遠くに昨日の笑い声が響く",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 2"
    },
    {
      "start": 13.64,
      "end": 21.42,
      "ja": "立ち止まることなく靴跡だけが重なっていくよ",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 3"
    },
    {
      "start": 21.42,
      "end": 27.48,
      "ja": "すれ違う人々の肩越しに見える小さな夢",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 4"
    },
    {
      "start": 27.48,
      "end": 37.68,
      "ja": "揺れる思い出はポケットの奥で光ってる",
      "ko_pron": "",
      "ko": "",
      "tag": "Chorus"
    },
    {
      "start": 37.68,
      "end": 43.96,
      "ja": "今日も変わらない僕だけのルールを守って",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 6"
    },
    {
      "start": 43.96,
      "end": 49.54,
      "ja": "踏み出した一歩が未来の地図を描き出す",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 7"
    },
    {
      "start": 49.54,
      "end": 55.12,
      "ja": "どんな困難も笑い飛ばすくらい強くなれる",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 8"
    },
    {
      "start": 55.12,
      "end": 62.2,
      "ja": "まだ終わらないストーリーをこの胸で抱きしめて",
      "ko_pron": "",
      "ko": "",
      "tag": "Post-Chorus"
    },
    {
      "start": 62.2,
      "end": 70.84,
      "ja": "迷っても大丈夫 君が隣にいるから",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 10"
    },
    {
      "start": 70.84,
      "end": 75.98,
      "ja": "朝焼け色の電車に揺られて新しい日を迎える",
      "ko_pron": "",
      "ko": "",
      "tag": "Verse 2"
    },
    {
      "start": 75.98,
      "end": 80.36,
      "ja": "交わした言葉はカバンの中でそっと温もりになる",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 12"
    },
    {
      "start": 80.36,
      "end": 85.78,
      "ja": "隠した弱ささえも少しずつ力に変えていける",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 13"
    },
    {
      "start": 85.78,
      "end": 90.48,
      "ja": "踏みしめるアスファルトが今日の道しるべになる",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 14"
    },
    {
      "start": 90.48,
      "end": 96.56,
      "ja": "揺れる思い出はポケットの奥で光ってる",
      "ko_pron": "",
      "ko": "",
