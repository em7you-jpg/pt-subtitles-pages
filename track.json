{
  "title": "Laundry Day Parade",
  "lines": [
    {
      "start": 3.72,
      "end": 3.72,
      "ja": "",
      "ko_pron": "",
      "ko": "",
      "tag": "Intro - instrumental"
    },
    {
      "start": 2.52,
      "end": 14.3,
      "ja": "乾いたシャツが風に踊る午後の部屋で",
      "ko_pron": "",
      "ko": "",
      "tag": "Verse 1"
    },
    {
      "start": 14.3,
      "end": 20.26,
      "ja": "洗剤の香りが静かに包みこむ気持ち",
      "ko_pron": "",
      "ko": "",
      "tag": "Pre-Chorus"
    },
    {
      "start": 20.26,
      "end": 26.58,
      "ja": "静かな音楽と一緒にたたみ始めたら",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 4"
    },
    {
      "start": 26.58,
      "end": 31.7,
      "ja": "くるくる丸めたタオルが小さな山になる",
      "ko_pron": "",
      "ko": "",
      "tag": "Chorus"
    },
    {
      "start": 31.7,
      "end": 39.3,
      "ja": "柔らかな手触りに笑顔こぼれる瞬間",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 6"
    },
    {
      "start": 39.3,
      "end": 45.5,
      "ja": "色とりどりの靴下並べてリズム合わせて",
      "ko_pron": "",
      "ko": "",
      "tag": "Verse 2"
    },
    {
      "start": 45.5,
      "end": 53.9,
      "ja": "片方探しながら思い出話を浮かべる",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 8"
    },
    {
      "start": 53.9,
      "end": 59.5,
      "ja": "洗剤の香りが静かに包みこむ気持ち",
      "ko_pron": "",
      "ko": "",
      "tag": "Pre-Chorus"
    },
    {
      "start": 59.5,
      "end": 65.76,
      "ja": "静かな音楽と一緒にたたみ始めたら",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 10"
    },
    {
      "start": 65.76,
      "end": 71.18,
      "ja": "くるくる丸めたタオルが小さな山になる",
      "ko_pron": "",
      "ko": "",
      "tag": "Chorus"
    },
    {
      "start": 71.18,
      "end": 80.38,
      "ja": "柔らかな手触りに笑顔こぼれる瞬間",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 12"
    },
    {
      "start": 80.38,
      "end": 84.84,
      "ja": "今日は誰にも邪魔されずに好きなだけ歌おう",
      "ko_pron": "",
      "ko": "",
      "tag": "Bridge"
    },
    {
      "start": 84.84,
      "end": 92.14,
      "ja": "シワを伸ばしながら自分だけのリズム刻む",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 14"
    },
    {
      "start": 92.14,
      "end": 97.04,
      "ja": "くるくる丸めたタオルが小さな山になる",
      "ko_pron": "",
      "ko": "",
      "tag": "Final Chorus"
    },
    {
      "start": 97.04,
      "end": 102.72,
      "ja": "柔らかな手触りを胸いっぱいに吸い込んで",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 16"
    },
    {
      "start": 102.72,
      "end": 109.84,
      "ja": "そっと並んだ洗濯物に「ありがとう」つぶやいた",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 17"
    },
    {
      "start": 109.84,
      "end": 119.34,
      "ja": "太陽色したシャツを畳む手が止まらないまま",
      "ko_pron": "",
      "ko": "",
      "tag": "Outro"
    }
  ],
