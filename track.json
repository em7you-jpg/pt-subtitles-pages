{
  "title": "クリアな理由だけ持って",
  "lines": [
    {
      "start": 0.76,
      "end": 0.76,
      "ja": "",
      "ko_pron": "",
      "ko": "",
      "tag": "Intro - instrumental"
    },
    {
      "start": 0.0,
      "end": 7.96,
      "ja": "目の前に広がる床の染みもぼんやりしてる朝に",
      "ko_pron": "",
      "ko": "",
      "tag": "Verse 1"
    },
    {
      "start": 7.96,
      "end": 15.64,
      "ja": "まだ眠たいまま鞄を椅子に投げて息を整える",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 3"
    },
    {
      "start": 15.64,
      "end": 25.08,
      "ja": "忘れ物一つだけ机に残したままの昨日",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 4"
    },
    {
      "start": 25.08,
      "end": 31.12,
      "ja": "ため息混じりの音でカップが小さく響いた",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 5"
    },
    {
      "start": 31.12,
      "end": 36.6,
      "ja": "ここから始まる今日を自分の手で選び取る",
      "ko_pron": "",
      "ko": "",
      "tag": "Pre-Chorus"
    },
    {
      "start": 36.6,
      "end": 42.54,
      "ja": "もう迷わないと小さく呟いた誰もいない部屋で",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 7"
    },
    {
      "start": 43.06,
      "end": 50.04,
      "ja": "振り返るたびに色が薄れていくノートの端",
      "ko_pron": "",
      "ko": "",
      "tag": "Chorus"
    },
    {
      "start": 50.04,
      "end": 54.78,
      "ja": "この瞬間だけは嘘をつかずに進もうと決めた",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 9"
    },
    {
      "start": 54.78,
      "end": 60.14,
      "ja": "余計な言葉より静かな決意だけポケットに入れて",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 10"
    },
    {
      "start": 60.14,
      "end": 76.32,
      "ja": "立ち止まるより先へ歩く理由を一つだけ大事に",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 11"
    },
    {
      "start": 76.32,
      "end": 82.06,
      "ja": "電車の音が窓越しに遠くなって響いてくる",
      "ko_pron": "",
      "ko": "",
      "tag": "Verse 2"
    },
    {
      "start": 82.06,
      "end": 88.4,
      "ja": "靴下のほつれすら今日は気にならない午前",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 13"
    },
    {
      "start": 88.4,
      "end": 92.3,
      "ja": "机の上で丸めた紙ごみをゴミ箱に投げたら",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 14"
    },
    {
      "start": 92.3,
      "end": 98.04,
      "ja": "もう戻れないと知ってる午後の光が差し込む",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 15"
    },
    {
      "start": 98.04,
      "end": 103.86,
      "ja": "ここから始まる今日を自分の手で選び取る",
      "ko_pron": "",
      "ko": "",
      "tag": "Pre-Chorus"
    },
    {
      "start": 103.86,
      "end": 109.34,
      "ja": "もう迷わないと小さく呟いた誰もいない部屋で",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 17"
    },
    {
      "start": 109.34,
      "end": 115.46,
      "ja": "振り返るたびに色が薄れていくノートの端",
      "ko_pron": "",
      "ko": "",
      "tag": "Chorus"
    },
    {
      "start": 115.46,
      "end": 120.56,
      "ja": "この瞬間だけは嘘をつかずに進もうと決めた",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 19"
    },
    {
      "start": 120.56,
      "end": 125.56,
      "ja": "余計な言葉より静かな決意だけポケットに入れて",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 20"
    },
    {
      "start": 125.56,
      "end": 131.52,
      "ja": "立ち止まるより先へ歩く理由を一つだけ大事に",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 21"
    },
    {
      "start": 131.52,
      "end": 136.58,
      "ja": "ビニール袋の隅に残った昨日のパンくずを捨てて",
      "ko_pron": "",
      "ko": "",
      "tag": "Bridge"
    },
    {
      "start": 136.58,
      "end": 143.62,
      "ja": "静かな午後に響くテレビの音を消したら始まる",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 23"
    },
    {
      "start": 143.62,
      "end": 150.46,
      "ja": "振り返るたびに色が薄れていくノートの端",
      "ko_pron": "",
      "ko": "",
      "tag": "Final Chorus"
    },
    {
      "start": 150.46,
      "end": 155.64,
      "ja": "この瞬間だけは嘘をつかずに進もうと決めた",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 25"
    },
    {
      "start": 155.64,
      "end": 160.8,
      "ja": "余計な言葉より静かな決意だけポケットに入れて",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 26"
    },
    {
      "start": 160.8,
      "end": 164.62,
      "ja": "立ち止まるより先へ歩く理由を一つだけ大事に",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 27"
    },
    {
      "start": 164.62,
      "end": 176.68,
      "ja": "もう戻らない部屋のドアを閉めて新しい音を探す",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 28"
    },
    {
      "start": 176.68,
      "end": 186.2,
      "ja": "電球の明かりが少しだけ揺れて消えるその瞬間まで",
      "ko_pron": "",
      "ko": "",
      "tag": "Outro"
    }
  ],
