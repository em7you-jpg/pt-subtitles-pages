    },
    {
      "start": 9.5,
      "end": 23.86,
      "ja": "目覚ましが鳴る前にカーテン越しの柔らかな朝 静かに起き上がる背中に昨日の疲れがまだ残る",
      "ko_pron": "",
      "ko": "",
      "tag": "Verse 1"
    },
    {
      "start": 23.86,
      "end": 38.2,
      "ja": "コーヒーの香りに包まれながら小さく深呼吸する",
      "ko_pron": "",
      "ko": "",
      "tag": "Pre-Chorus"
    },
    {
      "start": 38.2,
      "end": 75.02,
      "ja": "今日を始める勇気はポケットの奥で少しずつ温まる",
      "ko_pron": "",
      "ko": "",
      "tag": "Chorus"
    },
    {
      "start": 75.02,
      "end": 88.3,
      "ja": "靴紐を結び直して玄関のドアをそっと閉じる音",
      "ko_pron": "",
      "ko": "",
      "tag": "Verse 2"
    },
    {
      "start": 88.3,
      "end": 105.24,
      "ja": "コーヒーの香りに包まれながら小さく深呼吸する",
      "ko_pron": "",
