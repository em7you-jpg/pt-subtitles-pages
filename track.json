{
  "title": "Step Out in My Color",
  "lines": [
    {
      "start": 0.74,
      "end": 0.74,
      "ja": "",
      "ko_pron": "",
      "ko": "",
      "tag": "Intro - instrumental"
    },
    {
      "start": 0.0,
      "end": 4.94,
      "ja": "目の前に広がる白いタイルの廊下を歩く音が響いている",
      "ko_pron": "",
      "ko": "",
      "tag": "Verse 1"
    },
    {
      "start": 4.94,
      "end": 13.22,
      "ja": "今日はいつもより少し遅く家を出てみた朝の余韻が残る",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 3"
    },
    {
      "start": 13.22,
      "end": 20.62,
      "ja": "手元に残った定期券を握りしめたまま進む決心した",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 4"
    },
    {
      "start": 20.62,
      "end": 28.0,
      "ja": "迷いながらも自分だけのルールを胸に刻んだ",
      "ko_pron": "",
      "ko": "",
      "tag": "Pre-Chorus"
    },
    {
      "start": 28.0,
      "end": 33.56,
      "ja": "立ち止まることさえ昨日よりも少しだけ軽く感じている",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 6"
    },
    {
      "start": 33.56,
      "end": 42.42,
      "ja": "傘立ての隣に置いたままのバッグが揺れている",
      "ko_pron": "",
      "ko": "",
      "tag": "Chorus"
    },
    {
      "start": 42.42,
      "end": 47.46,
      "ja": "新しい一歩を踏み出すための合図を探していた",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 8"
    },
    {
      "start": 47.46,
      "end": 53.36,
      "ja": "踏切の遠くで響くベルの音が背中押してく",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 9"
    },
    {
      "start": 53.36,
      "end": 58.14,
      "ja": "進む道はまだぼやけているけど確かに歩き出す",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 10"
    },
    {
      "start": 58.14,
      "end": 68.66,
      "ja": "曲がり角の向こうに見える看板が少し色褪せていた",
      "ko_pron": "",
      "ko": "",
      "tag": "Verse 2"
    },
    {
      "start": 68.66,
      "end": 77.98,
      "ja": "何気ない朝の光がシャツの袖口をやさしく照らす",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 12"
    },
    {
      "start": 77.98,
      "end": 82.54,
      "ja": "昨日までの自分にそっとサヨナラを告げる気持ちで",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 13"
    },
    {
      "start": 82.54,
      "end": 89.22,
      "ja": "迷いながらも自分だけのルールを胸に刻んだ",
      "ko_pron": "",
      "ko": "",
      "tag": "Pre-Chorus"
    },
    {
      "start": 89.22,
      "end": 94.2,
      "ja": "立ち止まることさえ昨日よりも少しだけ軽く感じている",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 15"
    },
    {
      "start": 94.2,
      "end": 102.9,
      "ja": "傘立ての隣に置いたままのバッグが揺れている",
      "ko_pron": "",
      "ko": "",
      "tag": "Chorus"
    },
    {
      "start": 102.9,
      "end": 108.6,
      "ja": "新しい一歩を踏み出すための合図を探していた",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 17"
    },
    {
      "start": 108.6,
      "end": 114.18,
      "ja": "踏切の遠くで響くベルの音が背中押してく",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 18"
    },
    {
      "start": 114.18,
      "end": 119.64,
      "ja": "進む道はまだぼやけているけど確かに歩き出す",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 19"
    },
    {
      "start": 119.64,
      "end": 133.94,
      "ja": "置き忘れたノートの端に書いた夢はまだ消えていない",
      "ko_pron": "",
      "ko": "",
      "tag": "Bridge"
    },
    {
      "start": 133.94,
      "end": 138.48,
      "ja": "まぶしい信号の灯りが次の選択を静かに照らす",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 21"
    },
    {
      "start": 138.48,
      "end": 144.84,
      "ja": "傘立ての隣に置いたままのバッグが揺れている",
      "ko_pron": "",
      "ko": "",
      "tag": "Final Chorus"
    },
    {
      "start": 144.84,
      "end": 151.12,
      "ja": "新しい一歩を踏み出すための合図を探していた",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 23"
    },
    {
      "start": 151.12,
      "end": 156.2,
      "ja": "踏切の遠くで響くベルの音が背中押してく",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 24"
    },
    {
      "start": 156.2,
      "end": 160.94,
      "ja": "進む道はまだぼやけているけど確かに歩き出す",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 25"
    },
    {
      "start": 160.94,
      "end": 170.38,
      "ja": "サヨナラのかわりに深呼吸して明日を迎える準備をする",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 26"
    },
    {
      "start": 170.38,
      "end": 190.94,
      "ja": "靴裏で踏んだタイルの感触が今日の決意をそっと包む",
      "ko_pron": "",
      "ko": "",
      "tag": "Outro"
    }
  ],
