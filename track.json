{
  "title": "Packing for Tomorrow",
  "lines": [
    {
      "start": 0.0,
      "end": 3.46,
      "ja": "静かなキッチンでリュックのジッパー閉じる音だけ響く",
      "ko_pron": "",
      "ko": "",
      "tag": "Verse 1"
    },
    {
      "start": 3.46,
      "end": 10.88,
      "ja": "夕焼け色のシャツをそっと詰めていく手順記憶して",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 2"
    },
    {
      "start": 10.88,
      "end": 14.98,
      "ja": "四角い床に座って地図を折り畳む君の後ろ姿",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 3"
    },
    {
      "start": 14.98,
      "end": 20.92,
      "ja": "まだ見ぬ駅前の歩道橋想像しながら靴下を選ぶ",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 4"
    },
    {
      "start": 20.94,
      "end": 25.94,
      "ja": "何度も決めた決意が胸ポケットできらきら重なる",
      "ko_pron": "",
      "ko": "",
      "tag": "Chorus"
    },
    {
      "start": 25.94,
      "end": 32.14,
      "ja": "進む道は未知だけど昨日の自分を超えていく",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 6"
    },
    {
      "start": 32.14,
      "end": 38.1,
      "ja": "さよならよりも強い言葉は今はまだいらない",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 7"
    },
    {
      "start": 38.1,
      "end": 44.64,
      "ja": "ふわりと舞う埃の中で心は旅立ちを描く",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 8"
    },
    {
      "start": 44.64,
      "end": 49.68,
      "ja": "ぎゅっと詰め込んだメモ用紙ひとつだけお守りにして",
      "ko_pron": "",
      "ko": "",
      "tag": "Post-Chorus"
    },
    {
      "start": 49.68,
      "end": 65.74,
      "ja": "どんな朝も勇ましく歩き出せる気がするよ",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 10"
    },
    {
      "start": 65.74,
      "end": 70.22,
      "ja": "玄関のタイルに並ぶ小さな鞄たち見送りの気配",
      "ko_pron": "",
      "ko": "",
      "tag": "Verse 2"
    },
    {
      "start": 70.22,
      "end": 75.94,
      "ja": "ありがとうの代わりに窓ガラス越しに手を振る君",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 12"
    },
    {
      "start": 75.94,
      "end": 81.56,
      "ja": "ふと見上げた天井に貼った古いポスター色あせたまま",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 13"
    },
    {
