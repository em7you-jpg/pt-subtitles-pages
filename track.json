    },
    {
      "start": 11.84,
      "end": 24.46,
      "ja": "ひとつ息を整えながら夜明けのビルの隙間抜けてく",
      "ko_pron": "",
      "ko": "",
      "tag": "Verse 1"
    },
    {
      "start": 24.46,
      "end": 39.74,
      "ja": "見えないゴールだって踏み出せたらほら本当になる",
      "ko_pron": "",
      "ko": "",
      "tag": "Pre-Chorus"
    },
    {
      "start": 39.74,
      "end": 54.44,
      "ja": "計画した未来よりも今日をつなぐ手応え信じてる",
      "ko_pron": "",
      "ko": "",
      "tag": "Chorus"
    },
    {
      "start": 54.44,
      "end": 68.44,
      "ja": "静かな交差点で遠回りしても自分のペース守る",
      "ko_pron": "",
      "ko": "",
      "tag": "Verse 2"
    },
    {
      "start": 68.44,
      "end": 84.3,
      "ja": "見えないゴールだって踏み出せたらほら本当になる",
      "ko_pron": "",
      "ko": "",
      "tag": "Pre-Chorus"
    },
    {
      "start": 84.3,
      "end": 97.5,
      "ja": "計画した未来よりも今日をつなぐ手応え信じてる",
      "ko_pron": "",
      "ko": "",
      "tag": "Chorus"
    },
    {
      "start": 97.5,
      "end": 124.28,
      "ja": "立ち止まる勇気さえ今は大事な一歩と思えるから",
      "ko_pron": "",
      "ko": "",
      "tag": "Bridge"
    },
    {
      "start": 125.18,
      "end": 141.52,
      "ja": "計画した未来よりも今日をつなぐ手応え信じてる 置き去りにした焦りがそっと背中押してくれる",
      "ko_pron": "",
      "ko": "",
      "tag": "Final Chorus"
    },
    {
      "start": 141.52,
      "end": 168.12,
      "ja": "微かな朝の光が足元まで届いてまた歩き出せる",
      "ko_pron": "",
      "ko": "",
      "tag": "Outro"
    }
  ],
