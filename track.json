    {
      "start": 0.0,
      "end": 23.22,
      "ja": "ふたりの朝食テーブルで交わす言葉が少なくても",
      "ko_pron": "",
      "ko": "",
      "tag": "Verse 1"
    },
    {
      "start": 23.22,
      "end": 38.48,
      "ja": "ゆっくりとした時間のなかで心がほどけていく",
      "ko_pron": "",
      "ko": "",
      "tag": "Pre-Chorus"
    },
    {
      "start": 38.48,
      "end": 50.96,
      "ja": "静かな日々のなかに小さな発見が積もっていく",
      "ko_pron": "",
      "ko": "",
      "tag": "Chorus"
    },
    {
      "start": 50.96,
      "end": 86.58,
      "ja": "冷たいグラスの水滴が指になじむ午後の光",
      "ko_pron": "",
      "ko": "",
      "tag": "Verse 2"
    },
    {
      "start": 86.58,
      "end": 102.2,
      "ja": "ゆっくりとした時間のなかで心がほどけていく",
      "ko_pron": "",
      "ko": "",
      "tag": "Pre-Chorus"
    },
    {
      "start": 102.2,
      "end": 115.16,
      "ja": "静かな日々のなかに小さな発見が積もっていく",
      "ko_pron": "",
      "ko": "",
      "tag": "Chorus"
    },
    {
      "start": 115.16,
      "end": 136.76,
      "ja": "ささいなすれ違いも笑い話に変えていこう",
      "ko_pron": "",
      "ko": "",
      "tag": "Bridge"
    },
    {
      "start": 136.76,
      "end": 149.26,
      "ja": "静かな日々のなかに小さな発見が積もっていく ふたりでつくった秘密のルール忘れないように",
      "ko_pron": "",
      "ko": "",
      "tag": "Final Chorus"
    },
    {
      "start": 149.26,
      "end": 198.66,
      "ja": "歩いた床のきしみ音だけが残る部屋に手をふる",
      "ko_pron": "",
      "ko": "",
      "tag": "Outro"
    }
