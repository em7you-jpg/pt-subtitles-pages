{
  "title": "Turn the Key",
  "lines": [
    {
      "start": 0.0,
      "end": 5.08,
      "ja": "新しい朝に背中を向けて歩くけど",
      "ko_pron": "",
      "ko": "",
      "tag": "Verse 1"
    },
    {
      "start": 5.08,
      "end": 10.84,
      "ja": "昨日の荷物はそっと置いてきたから",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 2"
    },
    {
      "start": 10.84,
      "end": 16.6,
      "ja": "迷いの跡が指先から消えていく",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 3"
    },
    {
      "start": 16.6,
      "end": 22.54,
      "ja": "踏み出す道は誰にも見えないまま",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 4"
    },
    {
      "start": 22.54,
      "end": 26.74,
      "ja": "進み続けるだけで景色が変わる気がして",
      "ko_pron": "",
      "ko": "",
      "tag": "Chorus"
    },
    {
      "start": 26.74,
      "end": 32.02,
      "ja": "小さな勇気を何度も握りしめてみる",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 6"
    },
    {
      "start": 32.02,
      "end": 37.16,
      "ja": "離していくものが増えていく日々の中で",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 7"
    },
    {
      "start": 37.16,
      "end": 43.54,
      "ja": "君と見上げた雲の形だけ信じて",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 8"
    },
    {
      "start": 43.54,
      "end": 48.86,
      "ja": "この手に残る温もりを頼りにして",
      "ko_pron": "",
      "ko": "",
      "tag": "Post-Chorus"
    },
    {
      "start": 48.86,
      "end": 58.76,
      "ja": "明日を選ぶ理由を胸に隠していた",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 10"
    },
    {
      "start": 58.76,
      "end": 63.86,
      "ja": "交差点渡るとき心拍数が高まる",
      "ko_pron": "",
      "ko": "",
      "tag": "Verse 2"
    },
    {
      "start": 63.86,
      "end": 69.44,
      "ja": "目を閉じて吸い込む風の匂い感じた",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 12"
    },
    {
      "start": 69.44,
      "end": 74.52,
      "ja": "不安さえも味方にして歩幅合わせ",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 13"
    },
    {
      "start": 74.52,
      "end": 81.2,
      "ja": "すれ違う人の気配に慣れていく",
      "ko_pron": "",
      "ko": "",
      "tag": "Line 14"
    },
    {
